<mvc:View
    controllerName="empmgmt.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <Panel
                id="pnlEmployee"
                headerText="Employee Details"
            >
                <content>
                    <VBox
                        id="vboxEmployee"
                        width="100%"
                    >
                        <l:Grid
                            id="employeeGrid"
                            xmlns:l="sap.ui.layout"
                            defaultSpan="L4 M6 S12"
                            hSpacing="1"
                            vSpacing="1"
                        >
                            <Panel
                                id="pnlTotalEmployees"
                                headerText="Total Employees"
                            >
                                <content>
                                    <Text
                                        id="txtTotalEmployees"
                                        text="120"
                                    />
                                </content>
                            </Panel>

                            <Panel
                                id="pnlActiveEmployees"
                                headerText="Active Employees"
                            >
                                <content>
                                    <Text
                                        id="txtActiveEmployees"
                                        text="110"
                                    />
                                </content>
                            </Panel>

                            <Panel
                                id="pnlPendingLeaves"
                                headerText="Pending Leaves"
                            >
                                <content>
                                    <Text
                                        id="txtPendingLeaves"
                                        text="8"
                                    />
                                </content>
                            </Panel>
                        </l:Grid>
                    </VBox>
                </content>
            </Panel>

            <Panel
                id="pnlJsonModel"
                headerText="JSON Model"
            >
                <content>
                    <Text
                        id="txtName"
                        text="{/name}"
                    />

                    <Input
                        id="inpName"
                        value="{/name}"
                    />
                    <List
                        id="somelist"
                        items="{/employees}"
                    >
                        <items>
                            <StandardListItem
                                id="somelistitem"
                                title="{name}"
                                description="{department}"
                            />
                        </items>
                    </List>
                    <Table
                        id="employeeTable"
                        items="{/employees}"
                        mode="MultiSelect"
                        selectionChange=".onSelectionChange"
                    >
                        <columns>
                            <Column id="colName">
                                <Text
                                    id="sometext"
                                    text="Name"
                                />
                            </Column>

                            <Column id="colDepartment">
                                <Text
                                    id="sometext1"
                                    text="Department"
                                />
                            </Column>

                            <Column id="colRole">
                                <Text
                                    id="sometext2"
                                    text="Role"
                                />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem
                                id="employeeRow"
                                type="Navigation"
                                highlight="Information"
                            >
                                <cells>
                                    <Text
                                        id="sometext3"
                                        text="{name}"
                                    />
                                    <Text
                                        id="sometext4"
                                        text="{department}"
                                    />
                                    <Text
                                        id="sometext5"
                                        text="{role}"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>
        </content>
    </Page>
</mvc:View>
